# Copy to .env and change the passwords:   cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=payflow
# superuser: schema changes and admin only
POSTGRES_USER=payflow_admin
POSTGRES_PASSWORD=change_me_admin
# host port; change if 5432 is already taken
POSTGRES_PORT=5432

# used by services: read/write rows, no DDL
APP_DB_USER=payflow_app
APP_DB_PASSWORD=change_me_app
# used by analysts and BI: SELECT only
READONLY_DB_USER=payflow_readonly
READONLY_DB_PASSWORD=change_me_ro

# --- Simulator ---------------------------------------------------------------
# new payments per second
SIM_TPS=5
# share of ticks that start a fraud burst
SIM_FRAUD_RATE=0.01
# share of captured payments refunded
SIM_REFUND_RATE=0.05
# share of requests re-sent with the same idempotency key
SIM_DUPLICATE_RATE=0.02
# 0 = random each run; set e.g. 42 for a reproducible run
SIM_SEED=0
# debug | info | warn | error
LOG_LEVEL=info
